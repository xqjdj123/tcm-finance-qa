# ============================================================
# 环境变量模板 —— TCM-Finance-QA
#
# 作用：让凭据（DeepSeek key、MySQL 口令）不再以明文写进
#       config/config.yaml。环境变量优先级**高于** yaml
#       （见 agent/config.py:90-106 `_apply_env_overrides`）。
#
# 用法二选一：
#
#   A. 直接注入环境变量（临时/CI 首选）
#        Windows PowerShell 临时：  $env:DEEPSEEK_API_KEY="sk-..."
#        Windows 永久：             setx DEEPSEEK_API_KEY "sk-..."
#        Linux / macOS：            export DEEPSEEK_API_KEY="sk-..."
#
#   B. 用 .env 文件（本地开发推荐）
#        复制本文件为 .env 并填值即可。agent/config.py 的 _load_dotenv_early()
#        会**自动加载仓库根目录的 .env**（在模块级读取 os.environ 之前执行）。
#        解析优先级：python-dotenv（已安装时）→ 内置极简解析器（未安装时回退），
#        因此 .env 不构成新的硬依赖。
#        优先级：真实环境变量 > .env > config/config.yaml > 代码内置默认值
#        （若要临时压过 .env，直接设同名环境变量即可）。
#
# .env 与 config/config.yaml 均已列入 .gitignore，不会入库。
# ============================================================


# ---------- LLM（DeepSeek）----------
DEEPSEEK_API_KEY=sk-请替换为你的真实key
DEEPSEEK_MODEL=deepseek-chat


# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=finance_data
DB_USER=root
DB_PASSWORD=请替换为你的真实口令


# ---------- Web 服务 ----------
# 2026-09-14 已接线（此前为"配置孤儿"）：
#   app.py 现在读 config.yaml 的 server.host / server.port / server.debug，
#   而 agent/config.py 把环境变量 PORT / DEBUG 映射到 server.port / server.debug，
#   故下面两项**现在真实生效**。
# 优先级：环境变量 > config.yaml > 代码默认值（127.0.0.1 : 7860, debug=False）
# PORT=7860
# DEBUG=false


# ---------- RAG 查询改写 ----------
# 是否用真 LLM 改写检索查询（默认 false）。
#   false = 只用 normalize_query（去语气词 + 补公司名，零成本）
#   true  = 调 LLM 改写；失败/超时自动回退归一化。
#           ⚠️ 底层 LLMClient 固定 30s 超时，会显著增加 rag_search 延迟，
#              启用前请用数据论证收益（论文若要写"实现了 LLM 改写"须附对比）。
# RAG_LLM_REWRITE=0


# ---------- 验收脚本 ----------
# verify/common.py 的 app 端口（默认 7860）。端口被别的程序占用时改这里，
# 避免验收脚本"静默复用"到错误的 app 上导致结果失真。
# APP_PORT=7860
